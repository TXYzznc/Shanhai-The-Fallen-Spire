{
  "_comment": "统一 hooks：注入协作入口并检测决策门槛。",
  "hooks": {
    "PreToolUse": [],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node tools/codex_prompt_hook.js session"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node tools/codex_prompt_hook.js prompt"
          }
        ]
      }
    ]
  }
}
